---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CMS Dashboard" activePage="dashboard">
  <!-- Toast Notification System Container -->
  <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
      <h2 class="text-2xl font-bold text-white tracking-tight">CMS Dashboard</h2>
      <p class="text-sm text-slate-400 mt-1">Kelola data sites internal perusahaan dengan mudah.</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <!-- Download template btn -->
      <button
        id="download-template-btn"
        class="text-xs text-slate-450 hover:text-blue-400 underline transition-smooth mr-2 font-medium cursor-pointer"
        title="Download format file Excel untuk import data"
      >
        Download Template Import
      </button>
      
      <button 
        id="import-excel-btn"
        class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-750 font-semibold text-xs text-slate-350 hover:text-white transition-smooth border border-slate-700/30 hover:-translate-y-0.5 cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
        </svg>
        Import Excel / CSV
      </button>
      <input type="file" id="import-file-input" accept=".xlsx, .xls, .csv" class="hidden" />

      <button 
        id="open-add-modal-btn"
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 font-semibold text-sm text-white shadow-lg shadow-blue-500/25 transition-smooth hover:-translate-y-0.5 cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        Tambah Site Baru
      </button>
    </div>
  </div>

  <!-- Dashboard Stats Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <!-- Stat 1: Total Sites -->
    <div class="glass-panel p-5 rounded-2xl glow-blue flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-400 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
      </div>
      <div>
        <span class="text-xs font-semibold text-slate-400 tracking-wider uppercase">Total Sites</span>
        <h3 id="stat-total" class="text-2xl font-extrabold text-white mt-0.5">-</h3>
      </div>
    </div>

    <!-- Stat 2: CMS Types -->
    <div class="glass-panel p-5 rounded-2xl glow-purple flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-purple-500/10 flex items-center justify-center text-purple-400 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
      </div>
      <div>
        <span class="text-xs font-semibold text-slate-400 tracking-wider uppercase">CMS Unique</span>
        <h3 id="stat-cms" class="text-2xl font-extrabold text-white mt-0.5">-</h3>
      </div>
    </div>

    <!-- Stat 3: Template Types -->
    <div class="glass-panel p-5 rounded-2xl glow-emerald flex items-center gap-4">
      <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-400 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 01.724-.967l5.658-1.886a1 1 0 01.622 0l5.657 1.886A1 1 0 0117 5v1.5a1 1 0 01-.132.496L14 12V5H4v13.5A1.5 1.5 0 005.5 20h11.5a1.5 1.5 0 001.5-1.5V12h-2v6.5a.5.5 0 01-.5.5H5.5a.5.5 0 01-.5-.5V5z" />
        </svg>
      </div>
      <div>
        <span class="text-xs font-semibold text-slate-400 tracking-wider uppercase">Template Types</span>
        <h3 id="stat-templates" class="text-2xl font-extrabold text-white mt-0.5">-</h3>
      </div>
    </div>

    <!-- Stat 4: Mode Database -->
    <div class="glass-panel p-5 rounded-2xl flex items-center gap-4">
      <div id="stat-db-icon" class="w-12 h-12 rounded-xl bg-amber-500/10 flex items-center justify-center text-amber-400 shrink-0 transition-smooth">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
        </svg>
      </div>
      <div>
        <span class="text-xs font-semibold text-slate-400 tracking-wider uppercase">DB Connection</span>
        <h3 id="stat-db-mode" class="text-lg font-bold text-white mt-0.5">Connecting</h3>
      </div>
    </div>
  </div>

  <!-- Search & Toolbar -->
  <div class="glass-panel p-5 rounded-2xl mb-6">
    <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
      <!-- Search Input -->
      <div class="relative w-full md:max-w-md">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 pointer-events-none text-slate-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </span>
        <input 
          type="text" 
          id="search-input" 
          placeholder="Cari URL, ID Site, CMS, atau Template..." 
          class="w-full pl-11 pr-4 py-2.5 rounded-xl glass-input text-sm"
        />
      </div>

      <!-- Filters -->
      <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
        <select id="filter-cms" class="flex-1 sm:flex-initial px-4 py-2.5 rounded-xl glass-input text-sm">
          <option value="">Semua CMS</option>
        </select>
        <select id="filter-template" class="flex-1 sm:flex-initial px-4 py-2.5 rounded-xl glass-input text-sm">
          <option value="">Semua Template</option>
        </select>
        <button 
          id="reset-filter-btn" 
          class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 font-semibold text-xs text-slate-300 hover:text-white transition-smooth border border-slate-700/50"
        >
          Reset
        </button>
      </div>
    </div>
  </div>

  <!-- Sites Table Card -->
  <div class="glass-panel rounded-2xl overflow-hidden mb-6">
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-left text-sm text-slate-300">
        <thead class="bg-slate-900/50 border-b border-slate-850/80 text-xs text-slate-400 font-semibold uppercase tracking-wider">
          <tr>
            <th class="px-6 py-4.5 w-16">No</th>
            <th class="px-6 py-4.5 min-w-[200px]">URL Sites</th>
            <th class="px-6 py-4.5">ID Site</th>
            <th class="px-6 py-4.5">CMS</th>
            <th class="px-6 py-4.5">Template</th>
            <th class="px-6 py-4.5 w-32 text-center">Aksi</th>
          </tr>
        </thead>
        <tbody id="sites-table-body" class="divide-y divide-slate-800/40">
          <!-- Table skeletons will render first via JS -->
          <tr>
            <td colspan="6" class="px-6 py-12 text-center text-slate-400">
              <div class="flex flex-col items-center gap-3 justify-center">
                <svg class="animate-spin h-8 w-8 text-blue-500" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span>Memuat data dari database...</span>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Table Pagination & Footer -->
    <div class="flex items-center justify-between px-6 py-4 border-t border-slate-850/80 bg-slate-900/10 text-xs text-slate-450 font-semibold">
      <div id="table-entries-info" class="text-slate-400">
        Menampilkan 0 - 0 dari 0 entri
      </div>
      <div class="flex items-center gap-1.5">
        <button 
          id="prev-page-btn" 
          disabled 
          class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 disabled:opacity-40 disabled:hover:bg-slate-800 text-slate-300 transition-smooth border border-slate-700/40 cursor-pointer disabled:cursor-not-allowed"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        </button>
        <span id="page-num-indicator" class="px-3.5 py-1.5 rounded-lg bg-blue-600/10 text-blue-400 font-bold border border-blue-500/20">1</span>
        <button 
          id="next-page-btn" 
          disabled 
          class="p-2 rounded-lg bg-slate-800 hover:bg-slate-700 disabled:opacity-40 disabled:hover:bg-slate-800 text-slate-300 transition-smooth border border-slate-700/40 cursor-pointer disabled:cursor-not-allowed"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Modal: Add / Edit Site Form -->
  <div id="site-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="w-full max-w-md bg-[#0f1422] rounded-2xl border border-slate-800/80 shadow-2xl p-6 transition-transform duration-300 scale-95 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between pb-4 border-b border-slate-850/80 mb-5">
        <h4 id="modal-title" class="text-md font-bold text-white">Tambah Site Baru</h4>
        <button id="close-modal-btn" class="p-1 rounded-lg text-slate-400 hover:text-slate-200 transition-smooth">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5.5 w-5.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <form id="site-form" class="space-y-4">
        <input type="hidden" id="form-site-id-db" />
        
        <!-- URL Input -->
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5 uppercase tracking-wide">URL Site *</label>
          <input 
            type="text" 
            id="form-url" 
            placeholder="contoh: suaramerdeka.com" 
            required 
            class="w-full px-4 py-2.5 rounded-xl glass-input text-sm"
          />
        </div>

        <!-- ID Site Input -->
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5 uppercase tracking-wide">ID Site *</label>
          <input 
            type="text" 
            id="form-siteId" 
            placeholder="contoh: 04" 
            required 
            class="w-full px-4 py-2.5 rounded-xl glass-input text-sm"
          />
        </div>

        <!-- CMS Input -->
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5 uppercase tracking-wide">CMS ID / Code *</label>
          <input 
            type="text" 
            id="form-cms" 
            placeholder="contoh: 1" 
            required 
            class="w-full px-4 py-2.5 rounded-xl glass-input text-sm"
          />
        </div>

        <!-- Template Input -->
        <div>
          <label class="block text-xs font-semibold text-slate-400 mb-1.5 uppercase tracking-wide">Template *</label>
          <input 
            type="text" 
            id="form-template" 
            placeholder="contoh: news atau portal" 
            required 
            class="w-full px-4 py-2.5 rounded-xl glass-input text-sm"
          />
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center gap-3 pt-4 border-t border-slate-850/80 mt-5">
          <button 
            type="button" 
            id="cancel-form-btn" 
            class="flex-1 px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-sm transition-smooth"
          >
            Batal
          </button>
          <button 
            type="submit" 
            class="flex-1 px-4 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-sm shadow-lg shadow-blue-500/25 transition-smooth"
          >
            Simpan
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Delete Confirmation -->
  <div id="delete-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300">
    <div class="w-full max-w-sm bg-[#0f1422] rounded-2xl border border-slate-800/80 shadow-2xl p-6 transition-transform duration-300 scale-95">
      <div class="w-12 h-12 rounded-full bg-rose-500/10 text-rose-500 flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>

      <h4 class="text-md font-bold text-white mb-2">Hapus Site?</h4>
      <p class="text-sm text-slate-400 mb-5">Apakah Anda yakin ingin menghapus site <span id="delete-site-name" class="font-bold text-white"></span>? Tindakan ini tidak dapat dibatalkan.</p>

      <div class="flex items-center gap-3">
        <button 
          id="cancel-delete-btn" 
          class="flex-1 px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-sm transition-smooth"
        >
          Batal
        </button>
        <button 
          id="confirm-delete-btn" 
          class="flex-1 px-4 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-semibold text-sm shadow-lg shadow-rose-500/25 transition-smooth"
        >
          Hapus
        </button>
      </div>
    </div>
  </div>

  <script>
    import { getSites, addSite, updateSite, deleteSite, isUsingFirebase } from '../lib/firebase';
    import * as XLSX from 'xlsx';

    // Application state
    let allSites: any[] = [];
    let filteredSites: any[] = [];
    let currentPage = 1;
    const itemsPerPage = 10;
    
    let deleteId: string | null = null;
    let editId: string | null = null;

    // Toast notification function
    function showToast(message: string, type: 'success' | 'error' | 'info' = 'success') {
      const container = document.getElementById('toast-container');
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = `flex items-center gap-3 px-4 py-3.5 rounded-xl border shadow-xl transition-all duration-300 translate-y-2 opacity-0 select-none ${
        type === 'success' ? 'bg-emerald-950/80 border-emerald-500/30 text-emerald-400' :
        type === 'error' ? 'bg-rose-950/80 border-rose-500/30 text-rose-400' :
        'bg-slate-900/80 border-slate-700/40 text-slate-300'
      }`;

      // Toast icon
      const icon = type === 'success' 
        ? `<svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
        : type === 'error' 
        ? `<svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
        : `<svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`;

      toast.innerHTML = `
        ${icon}
        <span class="text-sm font-semibold">${message}</span>
      `;

      container.appendChild(toast);

      // Trigger animations
      setTimeout(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      }, 10);

      // Dismiss after 3s
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-[-4px]');
        setTimeout(() => toast.remove(), 300);
      }, 3000);
    }

    // Modal Control functions
    function toggleModal(modalId: string, open: boolean) {
      const modal = document.getElementById(modalId);
      if (!modal) return;
      
      const modalContainer = modal.firstElementChild;
      if (open) {
        modal.classList.remove('pointer-events-none', 'opacity-0');
        modal.classList.add('opacity-100');
        if (modalContainer) {
          modalContainer.classList.remove('scale-95');
          modalContainer.classList.add('scale-100');
        }
      } else {
        modal.classList.add('pointer-events-none', 'opacity-0');
        modal.classList.remove('opacity-100');
        if (modalContainer) {
          modalContainer.classList.remove('scale-100');
          modalContainer.classList.add('scale-95');
        }
      }
    }

    // Load CMS Data
    async function loadData() {
      const tableBody = document.getElementById('sites-table-body');
      
      try {
        const fbActive = isUsingFirebase();
        const dbText = document.getElementById('stat-db-mode');
        const dbIcon = document.getElementById('stat-db-icon');
        
        if (dbText && dbIcon) {
          if (fbActive) {
            dbText.innerText = 'Terkoneksi';
            dbText.className = 'text-md font-bold text-emerald-400';
            dbIcon.className = 'w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-400 shrink-0 glow-emerald';
          } else {
            dbText.innerText = 'Belum Terkoneksi';
            dbText.className = 'text-md font-bold text-rose-400';
            dbIcon.className = 'w-12 h-12 rounded-xl bg-rose-500/10 flex items-center justify-center text-rose-450 shrink-0';
          }
        }

        if (!fbActive) {
          allSites = [];
          filteredSites = [];
          if (tableBody) {
            tableBody.innerHTML = `
              <tr>
                <td colspan="6" class="px-6 py-12 text-center text-slate-400">
                  <div class="flex flex-col items-center gap-3.5 justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <span class="text-sm font-medium text-slate-300">Firebase belum terkonfigurasi. Silakan periksa file konfigurasi `.env` Anda.</span>
                  </div>
                </td>
              </tr>
            `;
          }
          updateStats();
          return;
        }

        // Fetch sites
        allSites = await getSites();
        
        // Initialize lists and filters
        populateFilterDropdowns();
        applyFiltersAndSearch();
        updateStats();
      } catch (error) {
        console.error('Failed to load sites:', error);
        showToast('Gagal memuat data dari database', 'error');
        if (tableBody) {
          tableBody.innerHTML = `
            <tr>
              <td colspan="6" class="px-6 py-8 text-center text-rose-450 font-medium bg-rose-950/5">
                Gagal memuat data. Silakan refresh halaman atau periksa konfigurasi Firebase Anda.
              </td>
            </tr>
          `;
        }
      }
    }

    // Populate drop-downs dynamically based on data
    function populateFilterDropdowns() {
      const filterCms = document.getElementById('filter-cms') as HTMLSelectElement;
      const filterTemplate = document.getElementById('filter-template') as HTMLSelectElement;
      
      if (!filterCms || !filterTemplate) return;

      const currentCmsVal = filterCms.value;
      const currentTmpVal = filterTemplate.value;

      // Extract unique CMS & Template values
      const cmsSet = new Set<string>();
      const tempSet = new Set<string>();

      allSites.forEach(site => {
        if (site.cms) cmsSet.add(site.cms);
        if (site.template) tempSet.add(site.template);
      });

      // Clear existing (preserve index 0)
      filterCms.innerHTML = '<option value="">Semua CMS</option>';
      filterTemplate.innerHTML = '<option value="">Semua Template</option>';

      // Append
      Array.from(cmsSet).sort().forEach(cms => {
        const option = document.createElement('option');
        option.value = cms;
        option.innerText = `CMS ${cms}`;
        filterCms.appendChild(option);
      });

      Array.from(tempSet).sort().forEach(temp => {
        const option = document.createElement('option');
        option.value = temp;
        option.innerText = temp.toUpperCase();
        filterTemplate.appendChild(option);
      });

      // Restore value
      filterCms.value = currentCmsVal;
      filterTemplate.value = currentTmpVal;
    }

    // Update Dashboard Metrics Cards
    function updateStats() {
      const statTotal = document.getElementById('stat-total');
      const statCms = document.getElementById('stat-cms');
      const statTemplates = document.getElementById('stat-templates');

      if (statTotal) statTotal.innerText = allSites.length.toString();
      
      if (statCms) {
        const uniqueCms = new Set(allSites.map(s => s.cms)).size;
        statCms.innerText = uniqueCms.toString();
      }

      if (statTemplates) {
        const uniqueTemplates = new Set(allSites.map(s => s.template)).size;
        statTemplates.innerText = uniqueTemplates.toString();
      }
    }

    // Render Table Rows
    function renderTable() {
      const tableBody = document.getElementById('sites-table-body');
      const prevBtn = document.getElementById('prev-page-btn') as HTMLButtonElement;
      const nextBtn = document.getElementById('next-page-btn') as HTMLButtonElement;
      const entriesInfo = document.getElementById('table-entries-info');
      const pageIndicator = document.getElementById('page-num-indicator');

      if (!tableBody) return;

      if (filteredSites.length === 0) {
        tableBody.innerHTML = `
          <tr>
            <td colspan="6" class="px-6 py-12 text-center text-slate-400">
              Tidak ada data sites yang cocok dengan pencarian atau filter.
            </td>
          </tr>
        `;
        if (entriesInfo) entriesInfo.innerText = 'Menampilkan 0 entri';
        if (prevBtn) prevBtn.disabled = true;
        if (nextBtn) nextBtn.disabled = true;
        if (pageIndicator) pageIndicator.innerText = '1';
        return;
      }

      // Calculate pagination
      const totalPages = Math.ceil(filteredSites.length / itemsPerPage);
      if (currentPage > totalPages) currentPage = Math.max(1, totalPages);

      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = Math.min(startIndex + itemsPerPage, filteredSites.length);
      const pageItems = filteredSites.slice(startIndex, endIndex);

      // Render items
      tableBody.innerHTML = '';
      pageItems.forEach((site, index) => {
        const rowNo = startIndex + index + 1;
        const linkUrl = site.url.startsWith('http://') || site.url.startsWith('https://') 
          ? site.url 
          : `https://${site.url}`;
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-800/25 transition-smooth group border-b border-slate-900/40';
        tr.innerHTML = `
          <td class="px-6 py-3.5 font-medium text-slate-450">${rowNo}</td>
          <td class="px-6 py-3.5 font-medium text-white group-hover:text-blue-400 transition-smooth">
            <a href="${linkUrl}" target="_blank" class="inline-flex items-center gap-1.5 hover:underline">
              ${site.url}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 opacity-0 group-hover:opacity-100 text-blue-500 transition-smooth" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </td>
          <td class="px-6 py-3.5"><span class="px-2 py-1 rounded-md bg-slate-800 text-xs font-semibold font-mono border border-slate-700/30 text-slate-300">${site.siteId}</span></td>
          <td class="px-6 py-3.5"><span class="px-2 py-1 rounded-md bg-purple-950/20 text-purple-400 border border-purple-500/10 font-bold text-xs">CMS ${site.cms}</span></td>
          <td class="px-6 py-3.5"><span class="px-2.5 py-1 rounded-full bg-blue-950/20 text-blue-400 border border-blue-500/10 font-semibold text-xs tracking-wide uppercase">${site.template}</span></td>
          <td class="px-6 py-3.5 text-center">
            <div class="flex items-center justify-center gap-2">
              <button 
                class="edit-site-btn p-1.5 rounded-lg text-slate-400 hover:text-blue-400 hover:bg-blue-500/10 transition-smooth cursor-pointer"
                data-id="${site.id}"
                title="Edit"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
              </button>
              <button 
                class="delete-site-btn p-1.5 rounded-lg text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 transition-smooth cursor-pointer"
                data-id="${site.id}"
                data-name="${site.url}"
                title="Hapus"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>
          </td>
        `;
        tableBody.appendChild(tr);
      });

      // Update Pagination UI
      if (entriesInfo) {
        entriesInfo.innerText = `Menampilkan ${startIndex + 1} - ${endIndex} dari ${filteredSites.length} entri`;
      }
      if (pageIndicator) {
        pageIndicator.innerText = currentPage.toString();
      }
      if (prevBtn) prevBtn.disabled = currentPage === 1;
      if (nextBtn) nextBtn.disabled = currentPage === totalPages;

      // Add actions event listeners
      document.querySelectorAll('.edit-site-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (id) openEditModal(id);
        });
      });

      document.querySelectorAll('.delete-site-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          const name = (e.currentTarget as HTMLElement).getAttribute('data-name');
          if (id && name) openDeleteModal(id, name);
        });
      });
    }

    // Apply Filter & Search query to table data
    function applyFiltersAndSearch() {
      const searchInput = document.getElementById('search-input') as HTMLInputElement;
      const filterCms = document.getElementById('filter-cms') as HTMLSelectElement;
      const filterTemplate = document.getElementById('filter-template') as HTMLSelectElement;

      const q = searchInput ? searchInput.value.toLowerCase().trim() : '';
      const cms = filterCms ? filterCms.value : '';
      const temp = filterTemplate ? filterTemplate.value : '';

      filteredSites = allSites.filter(site => {
        const matchesQuery = !q || 
          site.url.toLowerCase().includes(q) ||
          site.siteId.toLowerCase().includes(q) ||
          site.cms.toLowerCase().includes(q) ||
          site.template.toLowerCase().includes(q);

        const matchesCms = !cms || site.cms === cms;
        const matchesTemplate = !temp || site.template === temp;

        return matchesQuery && matchesCms && matchesTemplate;
      });

      currentPage = 1;
      renderTable();
    }

    // Modal Add Site Open
    const openAddModalBtn = document.getElementById('open-add-modal-btn');
    if (openAddModalBtn) {
      openAddModalBtn.addEventListener('click', () => {
        editId = null;
        const title = document.getElementById('modal-title');
        const form = document.getElementById('site-form') as HTMLFormElement;
        
        if (title) title.innerText = 'Tambah Site Baru';
        if (form) form.reset();
        
        const formIdInput = document.getElementById('form-site-id-db') as HTMLInputElement;
        if (formIdInput) formIdInput.value = '';

        const urlInput = document.getElementById('form-url') as HTMLInputElement;
        if (urlInput) urlInput.removeAttribute('readonly');

        toggleModal('site-modal', true);
      });
    }

    // Modal Edit Site Open
    function openEditModal(id: string) {
      editId = id;
      const site = allSites.find(s => s.id === id);
      if (!site) return;

      const title = document.getElementById('modal-title');
      const formIdInput = document.getElementById('form-site-id-db') as HTMLInputElement;
      const urlInput = document.getElementById('form-url') as HTMLInputElement;
      const siteIdInput = document.getElementById('form-siteId') as HTMLInputElement;
      const cmsInput = document.getElementById('form-cms') as HTMLInputElement;
      const templateInput = document.getElementById('form-template') as HTMLInputElement;

      if (title) title.innerText = 'Edit Detail Site';
      if (formIdInput) formIdInput.value = id;
      if (urlInput) {
        urlInput.value = site.url;
        // Don't let users edit the site URL since URL is unique, but it can be editable if they prefer. Let's keep it editable.
      }
      if (siteIdInput) siteIdInput.value = site.siteId;
      if (cmsInput) cmsInput.value = site.cms;
      if (templateInput) templateInput.value = site.template;

      toggleModal('site-modal', true);
    }

    // Modal Delete Site Open
    function openDeleteModal(id: string, name: string) {
      deleteId = id;
      const deleteNameSpan = document.getElementById('delete-site-name');
      if (deleteNameSpan) deleteNameSpan.innerText = name;
      toggleModal('delete-modal', true);
    }

    // Close Modals events
    const closeModalBtn = document.getElementById('close-modal-btn');
    const cancelFormBtn = document.getElementById('cancel-form-btn');
    const cancelDeleteBtn = document.getElementById('cancel-delete-btn');

    if (closeModalBtn) closeModalBtn.addEventListener('click', () => toggleModal('site-modal', false));
    if (cancelFormBtn) cancelFormBtn.addEventListener('click', () => toggleModal('site-modal', false));
    if (cancelDeleteBtn) cancelDeleteBtn.addEventListener('click', () => toggleModal('delete-modal', false));

    // Form Submit (Add / Edit)
    const siteForm = document.getElementById('site-form');
    if (siteForm) {
      siteForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const urlInput = document.getElementById('form-url') as HTMLInputElement;
        const siteIdInput = document.getElementById('form-siteId') as HTMLInputElement;
        const cmsInput = document.getElementById('form-cms') as HTMLInputElement;
        const templateInput = document.getElementById('form-template') as HTMLInputElement;

        const siteData = {
          url: urlInput.value.trim().toLowerCase(),
          siteId: siteIdInput.value.trim(),
          cms: cmsInput.value.trim(),
          template: templateInput.value.trim().toLowerCase()
        };

        // Basic domain validation
        if (!siteData.url.includes('.')) {
          showToast('Masukkan format URL domain yang valid (misal: suaramerdeka.com)', 'error');
          return;
        }

        try {
          if (editId) {
            // Edit existing site
            await updateSite(editId, siteData);
            showToast('Site berhasil diperbarui!', 'success');
          } else {
            // Add new site
            // Check for duplicates
            const isDuplicate = allSites.some(s => s.url.toLowerCase() === siteData.url);
            if (isDuplicate) {
              showToast(`Site dengan URL ${siteData.url} sudah terdaftar!`, 'error');
              return;
            }

            await addSite(siteData);
            showToast('Site baru berhasil ditambahkan!', 'success');
          }

          toggleModal('site-modal', false);
          loadData();
        } catch (error) {
          console.error(error);
          showToast('Gagal memproses data. Cek koneksi / database Anda.', 'error');
        }
      });
    }

    // Confirm Delete Event
    const confirmDeleteBtn = document.getElementById('confirm-delete-btn');
    if (confirmDeleteBtn) {
      confirmDeleteBtn.addEventListener('click', async () => {
        if (!deleteId) return;

        try {
          await deleteSite(deleteId);
          showToast('Site berhasil dihapus', 'success');
          toggleModal('delete-modal', false);
          loadData();
        } catch (error) {
          console.error(error);
          showToast('Gagal menghapus site dari database.', 'error');
        } finally {
          deleteId = null;
        }
      });
    }

    // Search and Filters inputs handlers
    const searchInput = document.getElementById('search-input');
    const filterCms = document.getElementById('filter-cms');
    const filterTemplate = document.getElementById('filter-template');
    const resetFilterBtn = document.getElementById('reset-filter-btn');

    if (searchInput) searchInput.addEventListener('input', applyFiltersAndSearch);
    if (filterCms) filterCms.addEventListener('change', applyFiltersAndSearch);
    if (filterTemplate) filterTemplate.addEventListener('change', applyFiltersAndSearch);
    
    if (resetFilterBtn) {
      resetFilterBtn.addEventListener('click', () => {
        if (searchInput) (searchInput as HTMLInputElement).value = '';
        if (filterCms) (filterCms as HTMLSelectElement).value = '';
        if (filterTemplate) (filterTemplate as HTMLSelectElement).value = '';
        applyFiltersAndSearch();
        showToast('Filter pencarian direset', 'info');
      });
    }

    // Pagination buttons click handlers
    const prevBtn = document.getElementById('prev-page-btn');
    const nextBtn = document.getElementById('next-page-btn');

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) {
          currentPage--;
          renderTable();
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        const totalPages = Math.ceil(filteredSites.length / itemsPerPage);
        if (currentPage < totalPages) {
          currentPage++;
          renderTable();
        }
      });
    }

    // Dismiss modals on clicking backdrop
    const siteModal = document.getElementById('site-modal');
    if (siteModal) {
      siteModal.addEventListener('click', (e) => {
        if (e.target === siteModal) toggleModal('site-modal', false);
      });
    }

    const deleteModal = document.getElementById('delete-modal');
    if (deleteModal) {
      deleteModal.addEventListener('click', (e) => {
        if (e.target === deleteModal) toggleModal('delete-modal', false);
      });
    }

    // Excel/CSV import handlers
    const importExcelBtn = document.getElementById('import-excel-btn');
    const importFileInput = document.getElementById('import-file-input') as HTMLInputElement;
    const downloadTemplateBtn = document.getElementById('download-template-btn');

    if (importExcelBtn && importFileInput) {
      importExcelBtn.addEventListener('click', () => {
        importFileInput.click();
      });

      importFileInput.addEventListener('change', async () => {
        const files = importFileInput.files;
        if (!files || files.length === 0) return;
        
        const file = files[0];
        showToast('Membaca file import...', 'info');
        
        const reader = new FileReader();
        reader.onload = async (evt) => {
          try {
            const data = new Uint8Array(evt.target?.result as ArrayBuffer);
            const workbook = XLSX.read(data, { type: 'array' });
            const firstSheetName = workbook.SheetNames[0];
            const worksheet = workbook.Sheets[firstSheetName];
            
            const jsonData = XLSX.utils.sheet_to_json(worksheet) as any[];
            if (jsonData.length === 0) {
              showToast('File Excel kosong atau format tidak sesuai', 'error');
              return;
            }

            let addedCount = 0;
            let skippedCount = 0;
            
            for (const row of jsonData) {
              let url = '';
              let siteId = '';
              let cms = '';
              let template = '';
              
              for (const key of Object.keys(row)) {
                const cleanKey = key.trim().toLowerCase();
                const val = String(row[key] ?? '').trim();
                
                if (cleanKey === 'url' || cleanKey === 'site url' || cleanKey === 'domain') {
                  url = val.toLowerCase();
                } else if (cleanKey === 'siteid' || cleanKey === 'id site' || cleanKey === 'idsite' || cleanKey === 'id') {
                  siteId = val;
                } else if (cleanKey === 'cms' || cleanKey === 'cms id' || cleanKey === 'cms_id') {
                  cms = val;
                } else if (cleanKey === 'template' || cleanKey === 'layout') {
                  template = val.toLowerCase();
                }
              }
              
              if (!url || !siteId || !cms || !template || !url.includes('.')) {
                skippedCount++;
                continue;
              }

              const exists = allSites.some(s => s.url.toLowerCase() === url);
              if (exists) {
                skippedCount++;
                continue;
              }
              
              await addSite({ url, siteId, cms, template });
              addedCount++;
            }
            
            if (addedCount > 0) {
              showToast(`Berhasil mengimpor ${addedCount} sites! (${skippedCount} baris dilewati/duplikat)`, 'success');
              loadData();
            } else {
              showToast(`Tidak ada site baru yang diimpor. (${skippedCount} baris tidak valid atau duplikat)`, 'info');
            }
          } catch (error) {
            console.error(error);
            showToast('Gagal membaca file Excel/CSV. Pastikan format kolom sesuai.', 'error');
          } finally {
            importFileInput.value = '';
          }
        };
        reader.readAsArrayBuffer(file);
      });
    }

    if (downloadTemplateBtn) {
      downloadTemplateBtn.addEventListener('click', () => {
        try {
          const headers = [['url', 'siteId', 'cms', 'template']];
          const rows = [
            ['suaramerdeka.com', '04', '1', 'news'],
            ['smol.id', '05', '1', 'news'],
            ['ayosemarang.com', '08', '2', 'portal'],
            ['jateng.tribunnews.com', '12', '2', 'news']
          ];
          
          const wsData = headers.concat(rows);
          const ws = XLSX.utils.aoa_to_sheet(wsData);
          
          ws['!cols'] = [
            { wch: 22 },
            { wch: 10 },
            { wch: 10 },
            { wch: 15 }
          ];

          const wb = XLSX.utils.book_new();
          XLSX.utils.book_append_sheet(wb, ws, 'Template Import');
          XLSX.writeFile(wb, 'template-import-sites.xlsx');
          showToast('Template import berhasil di-download', 'success');
        } catch (e) {
          console.error(e);
          showToast('Gagal men-download template', 'error');
        }
      });
    }

    // Initial load
    loadData();
  </script>
</Layout>
