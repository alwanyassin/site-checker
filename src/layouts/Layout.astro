---
import '../styles/global.css';

interface Props {
	title?: string;
	activePage?: 'dashboard' | 'lookup' | 'config';
}

const { title = 'Sites Registry CMS', activePage = 'dashboard' } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full bg-[#0b0f19]">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | CMS Pendataan Sites</title>
		<meta name="description" content="Sistem Informasi CMS dan pendataan site internal perusahaan. Membantu mengelola url site, id site, cms, template, pencarian bulk lookup, dan ekspor data ke Excel." />
	</head>
	<body class="flex h-full text-slate-100 overflow-hidden font-sans">
		<!-- Background Glows -->
		<div class="fixed top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-blue-600/5 blur-[120px] pointer-events-none -z-10"></div>
		<div class="fixed bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-purple-600/5 blur-[120px] pointer-events-none -z-10"></div>

		<!-- Sidebar Container -->
		<aside class="hidden md:flex flex-col w-64 glass-panel border-r border-slate-800/40 h-full text-slate-300">
			<!-- Logo -->
			<div class="flex items-center gap-3 px-6 h-20 border-b border-slate-800/40 shrink-0">
				<div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center shadow-lg shadow-blue-500/20">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" viewBox="0 0 20 20" fill="currentColor">
						<path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z" />
					</svg>
				</div>
				<div>
					<h1 class="text-md font-bold text-white tracking-tight leading-tight">SitesRegistry</h1>
					<span class="text-[10px] text-slate-400 font-medium tracking-wide uppercase">CMS Directory</span>
				</div>
			</div>

			<!-- Navigation Links -->
			<nav class="flex-1 px-4 py-6 space-y-1.5 overflow-y-auto">
				<!-- Dashboard Link -->
				<a href="/" class={`flex items-center gap-3 px-4 py-3 rounded-xl transition-smooth font-medium ${activePage === 'dashboard' ? 'bg-blue-600/10 text-blue-400 border border-blue-500/20 shadow-inner' : 'hover:bg-slate-800/40 text-slate-400 hover:text-slate-200 border border-transparent'}`}>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2v-4zM14 16a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2v-4z" />
					</svg>
					<span>CMS Dashboard</span>
				</a>

				<!-- Lookup Tool Link -->
				<a href="/lookup" class={`flex items-center gap-3 px-4 py-3 rounded-xl transition-smooth font-medium ${activePage === 'lookup' ? 'bg-blue-600/10 text-blue-400 border border-blue-500/20 shadow-inner' : 'hover:bg-slate-800/40 text-slate-400 hover:text-slate-200 border border-transparent'}`}>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
					</svg>
					<span>Bulk Site Lookup</span>
				</a>

				<!-- Config Link -->
				<a href="/config" class={`flex items-center gap-3 px-4 py-3 rounded-xl transition-smooth font-medium ${activePage === 'config' ? 'bg-blue-600/10 text-blue-400 border border-blue-500/20 shadow-inner' : 'hover:bg-slate-800/40 text-slate-400 hover:text-slate-200 border border-transparent'}`}>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
					</svg>
					<span>Firebase Setup</span>
				</a>
			</nav>

			<!-- Database connection indicator footer -->
			<div class="p-4 border-t border-slate-800/40 shrink-0">
				<div id="db-status-container" class="flex items-center justify-between px-3 py-2.5 rounded-xl bg-slate-900/60 border border-slate-800/60 transition-smooth">
					<div class="flex items-center gap-2">
						<span id="db-status-dot" class="relative flex h-2 w-2">
							<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
							<span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
						</span>
						<span id="db-status-text" class="text-xs font-semibold text-slate-400">Connecting...</span>
					</div>
					<a href="/config" class="text-[10px] text-blue-400 hover:text-blue-300 font-semibold tracking-wide uppercase">Setup</a>
				</div>
			</div>
		</aside>

		<!-- Mobile Header & Main Content Area -->
		<div class="flex-1 flex flex-col min-w-0 h-full overflow-hidden">
			<!-- Mobile Header -->
			<header class="md:hidden flex items-center justify-between px-6 h-16 glass-panel border-b border-slate-800/40 shrink-0 z-10">
				<div class="flex items-center gap-2.5">
					<div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center shadow-md">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 text-white" viewBox="0 0 20 20" fill="currentColor">
							<path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z" />
						</svg>
					</div>
					<h1 class="text-md font-bold text-white tracking-tight">SitesRegistry</h1>
				</div>

				<!-- Mobile menu button -->
				<button id="mobile-menu-btn" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-200 hover:bg-slate-800/40">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
				</button>
			</header>

			<!-- Mobile Side Nav Overlay -->
			<div id="mobile-menu-overlay" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 transition-opacity duration-300 opacity-0 pointer-events-none">
				<div id="mobile-menu" class="w-64 bg-[#0b0f19] h-full flex flex-col border-r border-slate-800/40 shadow-2xl transition-transform duration-300 -translate-x-full">
					<div class="flex items-center justify-between px-6 h-16 border-b border-slate-800/40">
						<div class="flex items-center gap-2">
							<div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5 text-white" viewBox="0 0 20 20" fill="currentColor">
									<path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z" />
								</svg>
							</div>
							<span class="text-md font-bold text-white tracking-tight">SitesRegistry</span>
						</div>
						<button id="close-mobile-menu-btn" class="p-1 rounded-lg text-slate-400 hover:text-slate-200">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
							</svg>
						</button>
					</div>

					<nav class="flex-1 p-4 space-y-1.5">
						<a href="/" class={`flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-smooth ${activePage === 'dashboard' ? 'bg-blue-600/10 text-blue-400 border border-blue-500/20' : 'text-slate-400 hover:bg-slate-800/40 hover:text-slate-200'}`}>
							CMS Dashboard
						</a>
						<a href="/lookup" class={`flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-smooth ${activePage === 'lookup' ? 'bg-blue-600/10 text-blue-400 border border-blue-500/20' : 'text-slate-400 hover:bg-slate-800/40 hover:text-slate-200'}`}>
							Bulk Site Lookup
						</a>
						<a href="/config" class={`flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-smooth ${activePage === 'config' ? 'bg-blue-600/10 text-blue-400 border border-blue-500/20' : 'text-slate-400 hover:bg-slate-800/40 hover:text-slate-200'}`}>
							Firebase Setup
						</a>
					</nav>

					<div class="p-4 border-t border-slate-800/40">
						<div id="mobile-db-status-container" class="flex items-center justify-between px-3 py-2.5 rounded-xl bg-slate-900/60 border border-slate-800/60">
							<div class="flex items-center gap-2">
								<span id="mobile-db-status-dot" class="h-2 w-2 rounded-full bg-amber-500"></span>
								<span id="mobile-db-status-text" class="text-xs text-slate-400">Connecting...</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Page Content Section -->
			<main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 relative">
				<slot />
			</main>
		</div>

		<!-- Script to update Firebase Connection Status indicators -->
		<script>
			import { isUsingFirebase } from '../lib/firebase';

			function updateDBStatusIndicators() {
				const connected = isUsingFirebase();
				
				const desktopDot = document.getElementById('db-status-dot');
				const desktopText = document.getElementById('db-status-text');
				const desktopContainer = document.getElementById('db-status-container');
				
				const mobileDot = document.getElementById('mobile-db-status-dot');
				const mobileText = document.getElementById('mobile-db-status-text');
				const mobileContainer = document.getElementById('mobile-db-status-container');

				const indicators = [
					{ dot: desktopDot, text: desktopText, container: desktopContainer },
					{ dot: mobileDot, text: mobileText, container: mobileContainer }
				];

				indicators.forEach(({ dot, text, container }) => {
					if (!container) return;

					if (connected) {
						if (dot) {
							dot.className = 'relative flex h-2 w-2';
							dot.innerHTML = `
								<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
								<span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
							`;
						}
						if (text) {
							text.innerText = 'Firebase Active';
							text.className = 'text-xs font-semibold text-emerald-400';
						}
						container.className = 'flex items-center justify-between px-3 py-2.5 rounded-xl bg-emerald-950/10 border border-emerald-500/20 transition-smooth';
					} else {
						if (dot) {
							dot.className = 'relative flex h-2 w-2';
							dot.innerHTML = `
								<span class="relative inline-flex rounded-full h-2 w-2 bg-rose-500"></span>
							`;
						}
						if (text) {
							text.innerText = 'Belum Terkoneksi';
							text.className = 'text-xs font-semibold text-rose-450';
						}
						container.className = 'flex items-center justify-between px-3 py-2.5 rounded-xl bg-rose-950/10 border border-rose-500/20 transition-smooth';
					}
				});
			}

			// Mobile Menu Handlers
			const mobileMenuBtn = document.getElementById('mobile-menu-btn');
			const closeMobileMenuBtn = document.getElementById('close-mobile-menu-btn');
			const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
			const mobileMenu = document.getElementById('mobile-menu');

			function openMobileMenu() {
				if (mobileMenuOverlay && mobileMenu) {
					mobileMenuOverlay.classList.remove('pointer-events-none', 'opacity-0');
					mobileMenuOverlay.classList.add('opacity-100');
					mobileMenu.classList.remove('-translate-x-full');
				}
			}

			function closeMobileMenu() {
				if (mobileMenuOverlay && mobileMenu) {
					mobileMenuOverlay.classList.add('pointer-events-none', 'opacity-0');
					mobileMenuOverlay.classList.remove('opacity-100');
					mobileMenu.classList.add('-translate-x-full');
				}
			}

			if (mobileMenuBtn) mobileMenuBtn.addEventListener('click', openMobileMenu);
			if (closeMobileMenuBtn) closeMobileMenuBtn.addEventListener('click', closeMobileMenu);
			if (mobileMenuOverlay) {
				mobileMenuOverlay.addEventListener('click', (e) => {
					if (e.target === mobileMenuOverlay) closeMobileMenu();
				});
			}

			// Run immediately and on DOMContentLoaded
			updateDBStatusIndicators();
			document.addEventListener('DOMContentLoaded', updateDBStatusIndicators);
		</script>
	</body>
</html>
